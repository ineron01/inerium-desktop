#!/usr/bin/env bash
# Title: Google Drive — подключить rclone
set -euo pipefail
configured() { rclone listremotes 2>/dev/null | grep -qx 'gdrive:'; }
if [[ "${1:-}" == --check ]]; then
    configured || exit 1
    if systemctl --user cat gdrive.service >/dev/null 2>&1; then
        systemctl --user is-enabled --quiet gdrive.service
    fi
    exit 0
fi

command -v rclone >/dev/null || { echo "rclone не установлен (пакет rclone)."; exit 1; }
if ! configured; then
    echo "Откроется браузер для входа в Google Drive через rclone..."
    rclone config create gdrive drive scope=drive
fi
if systemctl --user cat gdrive.service >/dev/null 2>&1; then
    systemctl --user daemon-reload
    systemctl --user enable --now gdrive.service
fi
