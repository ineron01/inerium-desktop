#!/usr/bin/env bash
# Title: Google Drive — подключить rclone
set -euo pipefail
configured() { rclone listremotes 2>/dev/null | grep -qx 'gdrive:'; }
if [[ "${1:-}" == --check ]]; then
    configured || exit 1
    if systemctl --user cat gdrive.service >/dev/null 2>&1; then
        systemctl --user is-enabled --quiet gdrive.service
    fi
    exit 0
fi

command -v rclone >/dev/null || { echo "rclone не установлен (пакет rclone)."; exit 1; }
if ! configured; then
    client_id="${CLIENT_ID:-}"
    client_secret="${CLIENT_SECRET:-}"
    if [[ -z "$client_id" && -t 0 ]]; then
        echo "Свой OAuth-клиент Google (Drive API) работает быстрее общего ключа rclone."
        echo "Его client_id/client_secret хранятся только локально в ~/.config/rclone/rclone.conf."
        echo "Оставьте поля пустыми, чтобы использовать общий ключ rclone."
        read -rp "client_id: " client_id
        read -rsp "client_secret: " client_secret
        echo
    fi
    echo "Откроется браузер для входа в Google Drive через rclone..."
    rclone config create gdrive drive scope=drive \
        ${client_id:+client_id="$client_id"} ${client_secret:+client_secret="$client_secret"}
fi
if systemctl --user cat gdrive.service >/dev/null 2>&1; then
    systemctl --user daemon-reload
    systemctl --user enable --now gdrive.service
fi
