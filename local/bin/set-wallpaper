#!/usr/bin/env python3
"""
Dynamic wallpaper setter and persister for hyprpaper in Hyprland.
Supports setting wallpaper globally or per-monitor without hardcoded monitor bindings.
"""
import sys
import os
import re
import json
import subprocess

CONF_PATH = os.path.expanduser("~/.config/hypr/hyprpaper.conf")

def get_connected_monitors():
    try:
        res = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, check=True)
        data = json.loads(res.stdout)
        return [m["name"] for m in data if isinstance(m, dict) and "name" in m]
    except Exception:
        return []

def parse_existing_conf(path):
    mon_map = {}
    fallback = None
    if not os.path.isfile(path):
        return mon_map, fallback
    
    try:
        with open(path, "r", encoding="utf-8") as f:
            content = f.read()
    except Exception:
        return mon_map, fallback

    blocks = re.findall(r'wallpaper\s*\{([^}]+)\}', content)
    for b in blocks:
        m = re.search(r'^[ \t]*monitor[ \t]*=[ \t]*(.*)$', b, re.MULTILINE)
        p = re.search(r'^[ \t]*path[ \t]*=[ \t]*(.*)$', b, re.MULTILINE)
        mon = m.group(1).strip() if m else ''
        path_val = p.group(1).strip() if p else ''
        if path_val:
            if mon:
                mon_map[mon] = path_val
            else:
                fallback = path_val
    return mon_map, fallback

def write_conf(path, mon_map, fallback):
    lines = ["# Auto-generated by set-wallpaper\n"]
    for mon in sorted(mon_map.keys()):
        p = mon_map[mon]
        lines.append(f"wallpaper {{\n    monitor = {mon}\n    path = {p}\n    fit_mode = cover\n}}\n\n")
    
    fb = fallback or (next(iter(mon_map.values())) if mon_map else "")
    if fb:
        lines.append(f"wallpaper {{\n    monitor = \n    path = {fb}\n    fit_mode = cover\n}}\n\n")
    lines.append("splash = false\n")

    tmp_path = path + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.writelines(lines)
    os.replace(tmp_path, path)

def main():
    if len(sys.argv) < 2:
        print("Usage: set-wallpaper <IMAGE_PATH> [MONITOR_NAME|all]")
        sys.exit(1)

    wall_path = os.path.abspath(os.path.expanduser(sys.argv[1]))
    if not os.path.isfile(wall_path):
        print(f"Error: File not found: {wall_path}", file=sys.stderr)
        sys.exit(1)

    target_mon = sys.argv[2].strip() if len(sys.argv) > 2 else "all"
    if not target_mon:
        target_mon = "all"

    connected = get_connected_monitors()
    mon_map, fallback = parse_existing_conf(CONF_PATH)

    if target_mon.lower() == "all":
        # Apply to all connected monitors
        targets = connected if connected else list(mon_map.keys())
        for mon in targets:
            subprocess.run(["hyprctl", "hyprpaper", "wallpaper", f"{mon},{wall_path}"], capture_output=True)
            mon_map[mon] = wall_path
        
        # Also ensure all known monitors are updated
        for k in list(mon_map.keys()):
            mon_map[k] = wall_path
            
        fallback = wall_path
        notify_title = "Обои обновлены (все экраны)"
    else:
        # Apply to specific monitor
        subprocess.run(["hyprctl", "hyprpaper", "wallpaper", f"{target_mon},{wall_path}"], capture_output=True)
        mon_map[target_mon] = wall_path

        # Mirror eDP-2 <-> eDP-1 for laptop display resilience
        if target_mon == "eDP-2":
            mon_map["eDP-1"] = wall_path
        elif target_mon == "eDP-1":
            mon_map["eDP-2"] = wall_path

        if not fallback:
            fallback = wall_path
        notify_title = f"Обои обновлены ({target_mon})"

    write_conf(CONF_PATH, mon_map, fallback)

    # Notification
    fname = os.path.basename(wall_path)
    subprocess.run([
        "notify-send",
        "-a", "Обои",
        "-i", wall_path,
        notify_title,
        fname
    ], capture_output=True)

if __name__ == "__main__":
    main()
