#!/usr/bin/env bash
# Управление панелью Waybar (Inerium Dragon): скрытие/показ, перезапуск, перезагрузка
set -euo pipefail

TARGET="${1:-toggle}"

case "$TARGET" in
    toggle)
        if pgrep -x waybar >/dev/null 2>&1; then
            killall -SIGUSR1 waybar 2>/dev/null || true
        else
            setsid waybar >/dev/null 2>&1 &
            notify-send -a "Панель" -i "preferences-system" "Панель" "Waybar запущен"
        fi
        ;;
    reload)
        killall -SIGUSR2 waybar 2>/dev/null || true
        notify-send -a "Панель" -i "preferences-system" "Панель" "Конфигурация Waybar перезагружена"
        ;;
    restart)
        if systemctl --user is-active waybar.service >/dev/null 2>&1; then
            systemctl --user restart waybar.service
        else
            pkill -x waybar 2>/dev/null || true
            sleep 0.2
            setsid waybar >/dev/null 2>&1 &
        fi
        notify-send -a "Панель" -i "preferences-system" "Панель" "Waybar перезапущен"
        ;;
    *)
        echo "Usage: $0 {toggle|reload|restart}"
        exit 1
        ;;
esac
