#!/usr/bin/env bash
# ==============================================================================
# inerium-askpass — диалог запроса пароля в единой эстетике Inerium Dragon
# Используется в качестве SUDO_ASKPASS / SSH_ASKPASS для скриптов и GUI-запросов
# ==============================================================================

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
    for s in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
        if [[ -S "$s" ]]; then
            export WAYLAND_DISPLAY="${s##*/}"
            break
        fi
    done
fi

prompt="${1:-Требуется подтверждение пароля:}"

# Очищаем промпт от лишних префиксов и двоеточий
clean_prompt="$(echo "$prompt" | sed -e 's/^\[sudo\] //' -e 's/:$//')"

rofi -dmenu \
     -password \
     -no-fixed-num-lines \
     -p "󰌾 " \
     -mesg "$clean_prompt" \
     -theme "$HOME/.config/rofi/askpass.rasi"
