/**
 * ============================================================================
 * [РЕЗЕРВНАЯ СЕССИЯ / BACKUP SESSION] — КОНФИГУРАЦИЯ ЛАУНЧЕРА ПРИЛОЖЕНИЙ ROFI
 * ============================================================================
 **/

configuration {
    modes: "drun,window,calc";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,keywords";
    sort: false;
    normalize-match: true;
    disable-history: false;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    display-drun: "󰍉";
    display-window: "󰕰";
    display-calc: "󰃬";
}

@theme "~/.config/rofi/kanagawa_backup.rasi"

/* Лаунчер приложений */
entry { placeholder: "Поиск приложений (Резервная сессия)…"; }
listview { lines: 7; }
element-icon { size: 30px; }
element-text { font: "JetBrainsMono Nerd Font Bold 10.5"; }
