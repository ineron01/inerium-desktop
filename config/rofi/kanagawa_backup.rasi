/**
 * ============================================================================
 * [РЕЗЕРВНАЯ СЕССИЯ / BACKUP SESSION] — ТЕМА ОФОРМЛЕНИЯ ROFI (KANAGAWA DRAGON)
 * Автономная копия темы rofi для резервной сессии.
 * ============================================================================
 **/

* {
    bg:           rgba(24, 22, 22, 0.97);
    surface:      #221f1f;
    surface-hi:   #2a2727;
    line:         rgba(197, 201, 197, 0.10);
    line-soft:    rgba(197, 201, 197, 0.07);
    fg:           #c5c9c5;
    fg-bright:    #e6e2cc;
    muted:        #737c73;
    green:        #87a987;
    green-soft:   rgba(135, 169, 135, 0.16);
    green-line:   rgba(135, 169, 135, 0.45);
    red:          #c4746e;

    font: "JetBrainsMono Nerd Font 10.5";
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 620px;
    border: 1px;
    border-color: @line;
    border-radius: 16px;
    background-color: @bg;
    padding: 14px;
}

mainbox {
    children: [ inputbar, message, listview ];
    spacing: 10px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 10px 14px;
    border: 1px;
    border-color: @line-soft;
    border-radius: 12px;
    background-color: @surface;
}

prompt {
    text-color: @green;
    vertical-align: 0.5;
}

entry {
    text-color: @fg-bright;
    placeholder-color: @muted;
    vertical-align: 0.5;
    cursor: text;
}

message {
    padding: 8px 12px;
    border-radius: 12px;
    background-color: @surface;
}
textbox { text-color: @muted; }

listview {
    columns: 1;
    lines: 7;
    spacing: 6px;
    fixed-height: true;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    spacing: 12px;
    border: 1px;
    border-color: @line-soft;
    border-radius: 12px;
    background-color: @surface;
    text-color: @fg;
    cursor: pointer;
}

element normal.normal, element alternate.normal {
    background-color: @surface;
    text-color: @fg;
}

element normal.active, element alternate.active {
    background-color: @green-soft;
    border-color: @green-line;
    text-color: @fg-bright;
}

element normal.urgent, element alternate.urgent {
    text-color: @red;
}

element selected.normal, element selected.active, element selected.urgent {
    background-color: @green-soft;
    border-color: @green-line;
    text-color: @fg-bright;
}

element-icon {
    size: 30px;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
    highlight: bold #87a987;
}
