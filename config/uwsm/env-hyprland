# ============================================================================
# Universal Wayland Session Manager (UWSM) — Окружение для композитора Hyprland
# ============================================================================

# Профиль запуска Hyprland
export HYPR_PROFILE="waybar"

# Синхронизация тем и размеров аппаратного и программного курсора
export HYPRCURSOR_THEME="Bibata-Modern-Ice"
export HYPRCURSOR_SIZE="24"
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE="24"

# Переменные, автоматически экспортируемые в systemd user manager через uwsm finalize
export UWSM_FINALIZE_VARNAMES="HYPRLAND_INSTANCE_SIGNATURE"

