[Unit]
Description=Hyprpaper wallpaper utility for Hyprland
Documentation=https://wiki.hyprland.org/Hypr-Ecosystem/hyprpaper/
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
# Resolved via the user manager PATH: a ~/.local/bin build wins over the packaged /usr/bin/hyprpaper
ExecStart=/usr/bin/env hyprpaper
Restart=on-failure
RestartSec=1
Slice=background-graphical.slice

[Install]
WantedBy=graphical-session.target
