[Unit]
Description=Hyprland IPC Bridge for Waybar compatibility
# Waybar 0.15 при клике по воркспейсу шлёт старый синтаксис "dispatch workspace N",
# который Hyprland 0.56 с Lua-конфигом не понимает. Мост переводит такие команды.
PartOf=graphical-session.target
After=graphical-session.target
Before=waybar.service

[Service]
Type=simple
ExecStart=%h/.local/bin/hypr-ipc-bridge
# Если мост упал/остановлен — вернуть родной сокет Hyprland, чтобы hyprctl не сломался
ExecStopPost=/bin/sh -c 'd="$${XDG_RUNTIME_DIR}/hypr/$${HYPRLAND_INSTANCE_SIGNATURE}"; [ -S "$$d/.socket.real.sock" ] && mv -f "$$d/.socket.real.sock" "$$d/.socket.sock" || true'
Restart=on-failure
RestartSec=1
Slice=session-graphical.slice
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
